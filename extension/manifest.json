{
  "manifest_version": 3,
  "name": "ElderSafety",
  "version": "0.1.0",
  "description": "A gentle second opinion before you pay: spots high-pressure sales pages and tech-support scams, and suggests trustworthy sources.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "setup.html",
  "action": { "default_title": "ElderSafety settings" },
  "storage": { "managed_schema": "data/managed-schema.json" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
